Algoritmo total_a_pagar
	Definir precio, cantidad, total Como Real;
	escribir "ingrese el precio del producto";
	leer precio;
	Escribir "ingresa la cantidad que lleva el cliente";
	leer cantidad
	total = precio * cantidad
	Escribir "el comprador debe pagar: ", total
	
	
	
	
FinAlgoritmo
