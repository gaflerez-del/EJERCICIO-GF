Algoritmo suma_y_promedio
	Definir n1, n2, n3, n4, suma, promedio Como Real
	Escribir  "ingrese el primer valor" 
	Leer n1;
	Escribir "ingresa el segundo valor"
	leer n2;
	Escribir "el trercer valor"
	leer n3;
	Escribir "el cuarto valor"
	leer n4;
	suma <- n1 + n2 + n3 + n4;
	promedio <- suma / 4;
	Escribir "la suma: ", suma;
	Escribir "el promedio es: ", promedio;
	
	
	
FinAlgoritmo
